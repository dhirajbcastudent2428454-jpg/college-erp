NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/college_erp_dev
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_32_chars
COOKIE_SECRET=replace_with_a_long_random_cookie_secret
FRONTEND_ORIGIN=http://localhost:3000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
DEMO_AUTH_ENABLED=false
EMAIL_PROVIDER=development
SMTP_HOST=
